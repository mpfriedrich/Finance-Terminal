{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Portfolio Lab (app)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "${workspaceFolder}/app.py"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Build fundamentals (SEC, ~1.4 GB download)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/build_fundamentals.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Refresh prices (incremental)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/build_prices.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Demo: chat to portfolio",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/demo_end_to_end.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Rebuild all prices (slow)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/build_prices.py",
      "args": [
        "--full"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}