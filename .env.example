# Template for .env.local — copy it once and fill in only what you use:
#
#     cp .env.example .env.local
#     open -e .env.local
#
# .env.local is gitignored: values you enter there never reach git. Never put a real
# value into THIS file, and never paste keys into a chat. An empty line means "not used".
# The app reads .env.local at start; restart it after a change.

# --- Free data (SEC + Yahoo + FRED): works without any key ------------------------------
# SEC asks every client for a contact address in its User-Agent. Commented out, the
# project's built-in default is sent. To send your own, remove the leading "# ".
# (Left empty but uncommented, SEC would get no contact at all and refuse requests.)
# SEC_USER_AGENT=portfolio-lab personal research (you@example.com)

# Which store the app screens: free (default), paid (Sharadar) or world (WRDS).
PORTFOLIO_LAB_SOURCE=free

# --- Optional: AI features (chat screens, summaries, morning briefing) ------------------
# A key from console.anthropic.com; usage is billed to the account it belongs to.
ANTHROPIC_API_KEY=

# --- Optional: live single ships on the MAP tab (aisstream.io, free key) ----------------
AISSTREAM_API_KEY=

# --- Optional, paid: Sharadar via Nasdaq Data Link, then scripts/build_paid.py ----------
NASDAQ_DATA_LINK_API_KEY=

# --- Optional, university only: WRDS (Compustat Global / CRSP), then build_wrds.py -----
# Personal accounts under a university licence: only the account holder may use them.
# Every connection sends a Duo push to the account holder's phone.
WRDS_USERNAME=
WRDS_PASSWORD=
# A second WRDS account that holds the CRSP licence, if the first one does not.
WRDS_CRSP_USERNAME=
WRDS_CRSP_PASSWORD=

# --- Optional: e-mail the morning briefing (scripts/morning_briefing.py) ----------------
# An app-specific password from the mail provider, not the normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_TO=
